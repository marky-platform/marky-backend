DEBUG=1
HOST=localhost
PORT=8000
DATABASE_URL=postgres://postgres:<postgres_pwd>@postgres:5432/postgres
SECRET_KEY=<random_string_goes_here>
FRONTEND_URL=http://localhost:3000

# Email (Resend SMTP)
EMAIL_HOST=smtp.resend.com
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<resend_api_key>
# Obligatorio en producción; debe ser un remitente verificado en Resend
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
EMAIL_PORT=587

# CORS — comma-separated list of frontend origins to allow in production
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Cloudflare R2 media storage (leave empty to use local filesystem)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: custom domain mapped to your R2 bucket (e.g. media.yourdomain.com)
AWS_S3_CUSTOM_DOMAIN=
# R2 has no real regions; "auto" is required so boto3 signs with SigV4
AWS_S3_REGION_NAME=auto

LOGGING_LEVEL=INFO
SENTRY_DSN=
# qa | production (no se infiere del nombre del entorno de Railway)
# SENTRY_ENVIRONMENT=qa
# Opcional; por defecto 1.0 con DEBUG=True y 0.1 sin DEBUG
# SENTRY_TRACES_SAMPLE_RATE=0.1
